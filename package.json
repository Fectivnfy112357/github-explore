{
  "name": "github-explore",
  "version": "3.1.2",
  "description": "Discovery + management wrappers around the gh CLI for AI coding agents. Ships as a standard agent skill, an Agent Plugins 1.0 plugin (plugin.json + skills/), and a dsh plugin (dsh.bundle.patch registers the skill at runtime).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "plugin.json",
    "README.md",
    "README_zh.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fectivnfy112357/github-explore.git"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-plugin",
    "skill",
    "github",
    "gh",
    "search",
    "discovery",
    "audit"
  ],
  "engines": {
    "node": "26.8.1",
    "dsh": "0.2.1-alpha.5 || 0.2.1-rc.1 || 0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.4 || 0.2.2-alpha.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-alpha.5": "compatible",
        "0.2.1-rc.1": "compatible",
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.3": "compatible",
        "0.2.1-rc.4": "compatible",
        "0.2.2-alpha.2": "compatible"
      }
    }
  },
  "scripts": {
    "prepack": "node scripts/prepack-clean.mjs"
  }
}
